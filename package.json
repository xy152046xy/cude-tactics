{
  "name": "cube-tactics-lan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3x3x3 双人回合制策略网页游戏（React + Canvas 2D + Express + Socket.io），支持局域网一键启动与 Zeabur / Render 一键云部署",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/server.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/rules.test.js tests/lan.test.js tests/quit.test.js tests/cloud.test.js",
    "start": "node server/server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
